@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&amp;display=swap');

.lw-root {
  --bg: #0b0e17;
  --panel: #111520;
  --border: rgba(255,255,255,0.07);
  --border-s: rgba(255,255,255,0.14);
  --text: #e6edf3;
  --muted: #6e7681;
  font-family: 'Inter','PingFang SC','Microsoft YaHei',sans-serif;
  background: var(--bg);
  border-radius: 16px;
  overflow: hidden;
  padding: 32px 20px 36px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  position: relative;
}

.lw-title {
  font-size: 12px;
  font-weight: 300;
  letter-spacing: 0.14em;
  color: var(--muted);
  text-transform: uppercase;
}

.lw-wheel-wrap {
  position: relative;
  width: 100%;
  max-width: 480px;
}

.lw-wheel-wrap canvas {
  width: 100%;
  height: auto;
  display: block;
}

.lw-score-pill {
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.05);
  border: 0.5px solid var(--border-s);
  border-radius: 20px;
  padding: 4px 18px;
  font-size: 11px;
  font-weight: 300;
  color: var(--muted);
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.lw-score-pill b { color: var(--text); font-weight: 500; }

.lw-open-btn {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,0.05);
  border: 0.5px solid var(--border-s);
  border-radius: 24px;
  padding: 8px 20px;
  color: var(--muted);
  font-size: 13px;
  font-family: inherit;
  font-weight: 400;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}
.lw-open-btn:hover {
  background: rgba(255,255,255,0.09);
  color: var(--text);
  border-color: rgba(255,255,255,0.22);
}
.lw-open-btn svg { opacity: 0.55; transition: opacity 0.2s; }
.lw-open-btn:hover svg { opacity: 1; }

/* overlay: covers only the card */
.lw-overlay {
  display: none;
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0);
  transition: background 0.3s;
  z-index: 10;
  border-radius: 16px;
}
.lw-overlay.open {
  display: block;
  background: rgba(0,0,0,0.5);
}

/* bottom sheet: absolute inside card */
.lw-sheet {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: var(--panel);
  border-top: 0.5px solid var(--border-s);
  border-radius: 16px 16px 0 0;
  transform: translateY(100%);
  transition: transform 0.38s cubic-bezier(0.32,0.72,0,1);
  z-index: 20;
  max-height: 72%;
  display: flex;
  flex-direction: column;
}
.lw-sheet.open { transform: translateY(0); }

.lw-handle {
  width: 34px; height: 4px;
  background: rgba(255,255,255,0.12);
  border-radius: 2px;
  margin: 13px auto 0;
  flex-shrink: 0;
}

.lw-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px 8px;
  flex-shrink: 0;
}
.lw-sheet-head h3 {
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.02em;
  margin: 0;
}

.lw-close {
  width: 26px; height: 26px;
  border-radius: 50%;
  border: 0.5px solid var(--border-s);
  background: rgba(255,255,255,0.04);
  color: var(--muted);
  font-size: 14px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.15s, color 0.15s;
  font-family: inherit;
}
.lw-close:hover { background: rgba(255,255,255,0.1); color: var(--text); }

.lw-body {
  overflow-y: auto;
  padding: 2px 18px 28px;
  flex: 1;
  -webkit-overflow-scrolling: touch;
}
.lw-body::-webkit-scrollbar { display: none; }

.lw-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 0.5px solid var(--border);
}
.lw-row:last-child { border-bottom: none; }

.lw-dot {
  width: 8px; height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}

.lw-label {
  font-size: 13px;
  font-weight: 400;
  color: var(--text);
  width: 28px;
  flex-shrink: 0;
}

.lw-slider-wrap { flex: 1; }

.lw-slider-wrap input[type=range] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 3px;
  border-radius: 2px;
  outline: none;
  cursor: pointer;
}
.lw-slider-wrap input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 15px; height: 15px;
  border-radius: 50%;
  background: var(--lw-thumb, #fff);
  border: 2px solid rgba(0,0,0,0.4);
  cursor: pointer;
}
.lw-slider-wrap input[type=range]::-moz-range-thumb {
  width: 15px; height: 15px;
  border-radius: 50%;
  background: var(--lw-thumb, #fff);
  border: 2px solid rgba(0,0,0,0.4);
  cursor: pointer;
  box-shadow: none;
}

.lw-val {
  font-size: 12px;
  font-weight: 500;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  width: 18px;
  text-align: right;
  flex-shrink: 0;
}
&lt;/style&gt;

&lt;div class='lw-root' id='lwRoot'&gt;
  &lt;div class='lw-title'&gt;生活质量轮盘&lt;/div&gt;

  &lt;div class='lw-wheel-wrap' id='lwWrap'&gt;
    &lt;canvas id='lwCanvas'&gt;&lt;/canvas&gt;
    &lt;div class='lw-score-pill'&gt;综合评分 &lt;b id='lwAvg'&gt;5.0&lt;/b&gt; / 10&lt;/div&gt;
  &lt;/div&gt;

  &lt;button class='lw-open-btn' id='lwOpenBtn'&gt;
    &lt;svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'&gt;
      &lt;circle cx='12' cy='12' r='3'/&gt;
      &lt;path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z'/&gt;
    &lt;/svg&gt;
    调整各项
  &lt;/button&gt;

  &lt;div class='lw-overlay' id='lwOverlay'&gt;&lt;/div&gt;

  &lt;div class='lw-sheet' id='lwSheet'&gt;
    &lt;div class='lw-handle'&gt;&lt;/div&gt;
    &lt;div class='lw-sheet-head'&gt;
      &lt;h3&gt;调整各项领域&lt;/h3&gt;
      &lt;button class='lw-close' id='lwClose'&gt;✕&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class='lw-body' id='lwBody'&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
(function(){
  var DOMAINS = [
    {name:'生理', c1:'#6ee7b7', c2:'#059669', c3:'#064e3b'},
    {name:'情感', c1:'#93c5fd', c2:'#2563eb', c3:'#1e3a8a'},
    {name:'财务', c1:'#fde68a', c2:'#d97706', c3:'#78350f'},
    {name:'娱乐', c1:'#fda4af', c2:'#e11d48', c3:'#881337'},
    {name:'成长', c1:'#bef264', c2:'#65a30d', c3:'#365314'},
    {name:'社交', c1:'#fdba74', c2:'#ea580c', c3:'#7c2d12'},
    {name:'服务', c1:'#d8b4fe', c2:'#9333ea', c3:'#4c1d95'},
    {name:'事业', c1:'#5eead4', c2:'#0d9488', c3:'#134e4a'},
    {name:'爱好', c1:'#f9a8d4', c2:'#db2777', c3:'#831843'},
  ];

  var N = DOMAINS.length;
  var levels = new Array(N).fill(5);

  var canvas = document.getElementById('lwCanvas');
  var ctx = canvas.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio||1, 2);

  function rgba(hex, a) {
    var r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
    return 'rgba('+r+','+g+','+b+','+a+')';
  }

  function resize() {
    var wrap = document.getElementById('lwWrap');
    var s = wrap.clientWidth;
    canvas.width = s * DPR;
    canvas.height = s * DPR;
    draw();
  }

  function draw() {
    var W = canvas.width, H = canvas.height;
    ctx.clearRect(0,0,W,H);
    var cx=W/2, cy=H/2;
    var maxR=W*0.425, minR=W*0.076;
    var RINGS=10, GAP=0.022;

    for(var r=1;r&lt;=RINGS;r++){
      var rad=minR+(maxR-minR)*r/RINGS;
      ctx.beginPath();ctx.arc(cx,cy,rad,0,Math.PI*2);
      ctx.strokeStyle=r===RINGS?'rgba(255,255,255,0.1)':'rgba(255,255,255,0.04)';
      ctx.lineWidth=r===RINGS?0.8*DPR:0.5*DPR;ctx.stroke();
    }
    for(var i=0;i&lt;N;i++){
      var a=(i/N)*Math.PI*2-Math.PI/2;
      ctx.beginPath();
      ctx.moveTo(cx+minR*Math.cos(a),cy+minR*Math.sin(a));
      ctx.lineTo(cx+maxR*Math.cos(a),cy+maxR*Math.sin(a));
      ctx.strokeStyle='rgba(255,255,255,0.06)';ctx.lineWidth=0.6*DPR;ctx.stroke();
    }

    for(var i=0;i&lt;N;i++){
      var lv=levels[i]; if(lv===0)continue;
      var d=DOMAINS[i];
      var startA=(i/N)*Math.PI*2-Math.PI/2+GAP;
      var endA=((i+1)/N)*Math.PI*2-Math.PI/2-GAP;
      var midA=(startA+endA)/2;
      var outerR=minR+(maxR-minR)*lv/RINGS;
      var x0=cx+minR*Math.cos(midA),y0=cy+minR*Math.sin(midA);
      var x1=cx+outerR*Math.cos(midA),y1=cy+outerR*Math.sin(midA);
      var gr=ctx.createLinearGradient(x0,y0,x1,y1);
      gr.addColorStop(0,   rgba(d.c3,0.4));
      gr.addColorStop(0.3, rgba(d.c2,0.72));
      gr.addColorStop(0.75,rgba(d.c2,0.9));
      gr.addColorStop(1,   rgba(d.c1,1));
      ctx.beginPath();
      ctx.moveTo(cx+minR*Math.cos(startA),cy+minR*Math.sin(startA));
      ctx.arc(cx,cy,outerR,startA,endA);
      ctx.arc(cx,cy,minR,endA,startA,true);
      ctx.closePath();ctx.fillStyle=gr;ctx.fill();
      ctx.beginPath();
      ctx.arc(cx,cy,outerR-0.5*DPR,startA+GAP*0.5,endA-GAP*0.5);
      ctx.strokeStyle=rgba(d.c1,0.75);ctx.lineWidth=1.4*DPR;ctx.stroke();
      var ig=ctx.createLinearGradient(x0,y0,x1,y1);
      ig.addColorStop(0,rgba(d.c3,0.22));ig.addColorStop(0.45,'rgba(0,0,0,0)');
      ctx.beginPath();
      ctx.moveTo(cx+minR*Math.cos(startA),cy+minR*Math.sin(startA));
      ctx.arc(cx,cy,outerR,startA,endA);
      ctx.arc(cx,cy,minR,endA,startA,true);
      ctx.closePath();ctx.fillStyle=ig;ctx.fill();
    }

    var cg=ctx.createRadialGradient(cx,cy,0,cx,cy,minR);
    cg.addColorStop(0,'#1c2233');cg.addColorStop(1,'#0d1117');
    ctx.beginPath();ctx.arc(cx,cy,minR,0,Math.PI*2);
    ctx.fillStyle=cg;ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.09)';ctx.lineWidth=0.8*DPR;ctx.stroke();

    var fs=Math.max(10,W*0.03);
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillStyle='rgba(230,237,243,0.7)';
    ctx.font='300 '+fs+'px 'Inter','PingFang SC',sans-serif';
    ctx.fillText('生活',cx,cy-fs*0.72);ctx.fillText('领域',cx,cy+fs*0.72);

    for(var i=0;i&lt;N;i++){
      var midA=((i+0.5)/N)*Math.PI*2-Math.PI/2;
      var labelR=maxR+W*0.044;
      var lx=cx+labelR*Math.cos(midA),ly=cy+labelR*Math.sin(midA);
      var lv=levels[i];
      ctx.beginPath();
      ctx.moveTo(cx+(maxR+W*0.008)*Math.cos(midA),cy+(maxR+W*0.008)*Math.sin(midA));
      ctx.lineTo(cx+(maxR+W*0.024)*Math.cos(midA),cy+(maxR+W*0.024)*Math.sin(midA));
      ctx.strokeStyle=lv&gt;0?rgba(DOMAINS[i].c1,0.55):'rgba(255,255,255,0.1)';
      ctx.lineWidth=DPR;ctx.stroke();
      ctx.save();ctx.translate(lx,ly);
      var rot=midA+Math.PI/2;
      if(midA&gt;Math.PI/2&amp;&amp;midA&lt;Math.PI*1.5)rot+=Math.PI;
      ctx.rotate(rot);
      var lfs=Math.max(10,W*0.031);
      ctx.fillStyle=lv&gt;0?'rgba(230,237,243,'+(0.55+lv*0.045)+')':'rgba(255,255,255,0.22)';
      ctx.font='400 '+lfs+'px 'Inter','PingFang SC',sans-serif';
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(DOMAINS[i].name,0,0);ctx.restore();
    }
    var avg=(levels.reduce(function(a,b){return a+b;},0)/N).toFixed(1);
    document.getElementById('lwAvg').textContent=avg;
  }

  function updateTrack(el, val, color) {
    var pct = val*10;
    el.style.background='linear-gradient(to right,'+color+' 0%,'+color+' '+pct+'%,rgba(255,255,255,0.08) '+pct+'%)';
  }

  var body = document.getElementById('lwBody');
  DOMAINS.forEach(function(d,i){
    var row=document.createElement('div');row.className='lw-row';
    row.innerHTML='&lt;div class='lw-dot' style='background:'+d.c2+''&gt;&lt;/div&gt;'+
      '&lt;span class='lw-label'&gt;'+d.name+'&lt;/span&gt;'+
      '&lt;div class='lw-slider-wrap'&gt;&lt;input type='range' min='0' max='10' value='5' step='1' id='lwS'+i+'' style='--lw-thumb:'+d.c1+''&gt;&lt;/div&gt;'+
      '&lt;span class='lw-val' id='lwV'+i+''&gt;5&lt;/span&gt;';
    body.appendChild(row);
    var sl=document.getElementById('lwS'+i);
    updateTrack(sl,5,d.c2);
    sl.addEventListener('input',function(){
      var v=+sl.value;levels[i]=v;
      document.getElementById('lwV'+i).textContent=v;
      updateTrack(sl,v,d.c2);draw();
    });
  });

  var sheet=document.getElementById('lwSheet');
  var overlay=document.getElementById('lwOverlay');
  function openSheet(){sheet.classList.add('open');overlay.classList.add('open');}
  function closeSheet(){sheet.classList.remove('open');overlay.classList.remove('open');}
  document.getElementById('lwOpenBtn').addEventListener('click',openSheet);
  document.getElementById('lwClose').addEventListener('click',closeSheet);
  overlay.addEventListener('click',closeSheet);
  var ty0=0;
  sheet.addEventListener('touchstart',function(e){ty0=e.touches[0].clientY;},{passive:true});
  sheet.addEventListener('touchend',function(e){if(e.changedTouches[0].clientY-ty0&gt;60)closeSheet();},{passive:true});

  var ro=new ResizeObserver(resize);
  ro.observe(document.getElementById('lwWrap'));
  resize();
})();
&lt;/script&gt;。</description><guid isPermaLink="true">https://luliyer6-ux.github.io/post/ren-sheng.html</guid><pubDate>Sat, 27 Jun 2026 16:24:35 +0000</pubDate></item><item><title>测试</title><link>https://luliyer6-ux.github.io/post/ce-shi.html</link><description>11111。</description><guid isPermaLink="true">https://luliyer6-ux.github.io/post/ce-shi.html</guid><pubDate>Sat, 27 Jun 2026 06:11:43 +0000</pubDate></item><item><title>gemmk 博客指南</title><link>https://luliyer6-ux.github.io/post/gemmk%20-bo-ke-zhi-nan.html</link><description>&lt;html&gt;
